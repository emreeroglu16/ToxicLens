<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>

    <cloud-backup>
        <!-- Do not back up local analysis/history/settings data. -->
        <exclude
            domain="file"
            path="datastore/" />
    </cloud-backup>

    <device-transfer>
        <!-- Do not transfer local analysis/history/settings data to another device. -->
        <exclude
            domain="file"
            path="datastore/" />
    </device-transfer>

</data-extraction-rules>